# =============================================================================
# Enterprise HRIS Prototype — Environment Configuration
# Copy this file to `.env` and adjust as needed. NEVER commit `.env`.
# =============================================================================

# ---- General ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=enterprise-hris
ENV=development
TZ=Asia/Manila

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=hris
POSTGRES_PASSWORD=hris_dev_password
POSTGRES_DB=hris
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://hris:hris_dev_password@postgres:5432/hris

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- MinIO (S3-compatible document storage) ---------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=hris-documents
MINIO_SECURE=false

# ---- Authentication / Security ----------------------------------------------
# CHANGE THIS in any non-throwaway environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Storage monitoring -----------------------------------------------------
# Path inside the backend container whose disk usage is reported to the
# storage dashboard. Defaults to the data mount.
STORAGE_MONITOR_PATH=/data
# Simulated total capacity (GB) used for prototype threshold demos when the
# real mount is very large. Set to 0 to always use real filesystem totals.
STORAGE_SIMULATED_CAPACITY_GB=50

# ---- Seeding ----------------------------------------------------------------
SEED_ON_STARTUP=true
DEFAULT_ADMIN_EMAIL=admin@demo-hris.local
DEFAULT_ADMIN_PASSWORD=Admin123!

# ---- Frontend ---------------------------------------------------------------
# Base path the browser uses to reach the API (proxied by nginx).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ---- Mail (development only, via MailHog) -----------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@demo-hris.local

# ---- CORS -------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:3000
