# GEEK Group HRIS — Apache config for shared hosting (Bluehost / Zoom)
Options -Indexes

# --- Make the Authorization (Bearer token) header reach PHP -------------------
# Shared hosting (LiteSpeed/CGI/FastCGI) often strips it, which causes random
# "logged out" behaviour. These give PHP several ways to receive it.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # API → PHP front controller.
    RewriteRule ^api/v1(/.*)?$ api/index.php [QSA,L]

    # SPA fallback: serve index.html for any non-file, non-API route.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ index.html [L]
</IfModule>

# --- Performance: compress text assets, cache hashed build files -------------
# Cuts the ~275KB JS download to ~85KB and lets the browser reuse assets between
# visits, so the app loads faster on every connection (not an internet fix).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/xml \
        text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Vite build assets are content-hashed (index-XXXX.js) — safe to cache hard.
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 month"
    ExpiresByType image/png             "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 1 month"
    ExpiresByType font/woff2            "access plus 1 year"
    # index.html must NEVER be cached, so new deploys are picked up immediately.
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# Force HTTPS once your SSL certificate is active (uncomment on production):
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
